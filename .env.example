# Copia este archivo como .env y completa la clave del proveedor que uses.
# El archivo .env esta en .gitignore: nunca se sube al repositorio.

# Proveedor del LLM: "gemini" o "anthropic".
# La traza incluida en logs/ fue generada con gemini.
PROVEEDOR=gemini

# --- Si PROVEEDOR=anthropic -------------------------------------------------
# Clave de la consola de API: https://platform.claude.com/settings/keys (empieza con sk-ant-)
ANTHROPIC_API_KEY=pega_aca_tu_clave

# --- Si PROVEEDOR=gemini ----------------------------------------------------
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=pega_aca_tu_clave

# Modelo a usar. Si se deja vacio, cada proveedor usa su default:
#   anthropic -> claude-haiku-4-5-20251001
#   gemini    -> gemini-3.6-flash
# Conviene fijar la version exacta y no un alias tipo "latest": los alias
# cambian solos y la entrega dejaria de ser reproducible.
MODELO_LLM=

# Temperatura: 0 = respuestas deterministas, recomendado para agentes con tools
TEMPERATURA=0

# Techo de pasos del grafo. Evita bucles infinitos y costos inesperados.
LIMITE_RECURSION=10

# Cuantos mensajes del historial se le mandan al modelo en cada llamada.
MAX_MENSAJES_CONTEXTO=20

# Segundos maximos de espera por cada llamada al modelo. Si se supera, el
# intento se cancela y se reintenta en vez de quedarse colgado.
TIMEOUT_MODELO=90
